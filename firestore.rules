rules_version = '2';
// republish-marker: 2026-06-20
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function myFamilyId() {
      return myProfile().get('familyId', null);
    }

    function isParent() {
      return isSignedIn() && myProfile().get('role', null) == 'parent';
    }

    function isParentOf(uid) {
      return isSignedIn() && myProfile().get('role', null) == 'parent' &&
        myFamilyId() == get(/databases/$(database)/documents/users/$(uid)).data.get('familyId', null);
    }

    function requiresApproval(uid) {
      // .get(field, default) avoids an evaluation error when a user has never
      // had requireFriendApproval explicitly set (e.g. left on default/Automatic).
      return get(/databases/$(database)/documents/users/$(uid)).data.get('requireFriendApproval', false) == true;
    }

    match /users/{userId} {
      allow read: if isSignedIn() &&
        (request.auth.uid == userId || resource.data.familyId == myFamilyId());
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() &&
        (request.auth.uid == userId ||
         (isParentOf(userId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['requireFriendApproval'])));
      allow delete: if false;
    }

    match /families/{familyId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.code == familyId;
      allow update, delete: if false;
    }

    match /lunches/{lunchId} {
      allow read: if isSignedIn() && resource.data.familyId == myFamilyId();
      allow create: if isSignedIn() &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.familyId == myFamilyId();
      allow update, delete: if isSignedIn() && resource.data.familyId == myFamilyId();
    }

    match /weeklyPlans/{planId} {
      allow read: if isSignedIn() && resource.data.familyId == myFamilyId();
      allow create, update: if isParent() && request.resource.data.familyId == myFamilyId();
      allow delete: if false;
    }

    match /friendCodes/{code} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn() &&
        request.resource.data.uid == resource.data.uid &&
        (request.auth.uid == resource.data.uid ||
         (isParentOf(resource.data.uid) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['requireFriendApproval'])));
      allow delete: if false;
    }

    match /friendRequests/{requestId} {
      allow read: if isSignedIn() &&
        (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid ||
         isParentOf(resource.data.fromUid) || isParentOf(resource.data.toUid));

      allow create: if isSignedIn() &&
        request.auth.uid == request.resource.data.fromUid &&
        request.resource.data.toUid != request.auth.uid &&
        request.resource.data.fromApproved == !requiresApproval(request.resource.data.fromUid) &&
        request.resource.data.toApproved == !requiresApproval(request.resource.data.toUid) &&
        request.resource.data.status ==
          ((request.resource.data.fromApproved && request.resource.data.toApproved) ? 'accepted' : 'pending');

      allow update: if isSignedIn() &&
        (
          (isParentOf(resource.data.fromUid) &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fromApproved', 'status']) &&
           (
             (request.resource.data.fromApproved == true &&
              request.resource.data.status == (resource.data.toApproved == true ? 'accepted' : 'pending')) ||
             (request.resource.data.fromApproved == false && request.resource.data.status == 'rejected')
           )) ||
          (isParentOf(resource.data.toUid) &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['toApproved', 'status']) &&
           (
             (request.resource.data.toApproved == true &&
              request.resource.data.status == (resource.data.fromApproved == true ? 'accepted' : 'pending')) ||
             (request.resource.data.toApproved == false && request.resource.data.status == 'rejected')
           ))
        );

      allow delete: if false;
    }

    match /friendships/{friendshipId} {
      allow read: if isSignedIn() &&
        (request.auth.uid == resource.data.uid1 || request.auth.uid == resource.data.uid2);
      allow create: if isSignedIn() &&
        (request.auth.uid == request.resource.data.uid1 || request.auth.uid == request.resource.data.uid2 ||
         isParentOf(request.resource.data.uid1) || isParentOf(request.resource.data.uid2));
      allow update, delete: if false;
    }
  }
}
