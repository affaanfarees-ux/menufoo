rules_version = '2';
// republish-marker: 2026-06-20-01
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function myFamilyId() {
      return myProfile().get('familyId', null);
    }

    function isParent() {
      return isSignedIn() && myProfile().get('role', null) == 'parent';
    }

    function isParentOf(uid) {
      return uid != null && isSignedIn() && myProfile().get('role', null) == 'parent' &&
        myFamilyId() == get(/databases/$(database)/documents/users/$(uid)).data.get('familyId', null);
    }

    function requiresApproval(uid) {
      // .get(field, default) avoids an evaluation error when a user has never
      // had requireFriendApproval explicitly set (e.g. left on default/Automatic).
      return uid != null &&
        get(/databases/$(database)/documents/users/$(uid)).data.get('requireFriendApproval', false) == true;
    }

    match /users/{userId} {
      allow read: if isSignedIn() &&
        (request.auth.uid == userId || resource.data.get('familyId', null) == myFamilyId());
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() &&
        (request.auth.uid == userId ||
         (isParentOf(userId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['requireFriendApproval'])));
      allow delete: if false;
    }

    match /families/{familyId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.code == familyId;
      allow update, delete: if false;
    }

    match /lunches/{lunchId} {
      allow read: if isSignedIn() && resource.data.get('familyId', null) == myFamilyId();
      allow create: if isSignedIn() &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.familyId == myFamilyId();
      allow update, delete: if isSignedIn() && resource.data.get('familyId', null) == myFamilyId();
    }

    match /weeklyPlans/{planId} {
      allow read: if isSignedIn() && resource.data.get('familyId', null) == myFamilyId();
      allow create, update: if isParent() && request.resource.data.familyId == myFamilyId();
      allow delete: if false;
    }

    match /friendCodes/{code} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn() &&
        request.resource.data.uid == resource.data.uid &&
        (request.auth.uid == resource.data.uid ||
         (isParentOf(resource.data.uid) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['requireFriendApproval'])));
      allow delete: if false;
    }

    match /friendRequests/{requestId} {
      // Note: avoids isParentOf(resource.data.X) here -- list/query reads are
      // authorized using only request-constant values (our own uid/role/family)
      // compared against document fields, not a per-document cross-reference
      // into another document, which Firestore can't validate for list ops.
      allow read: if isSignedIn() &&
        (resource.data.get('fromUid', null) == request.auth.uid ||
         resource.data.get('toUid', null) == request.auth.uid ||
         (myProfile().get('role', null) == 'parent' &&
          (resource.data.get('fromFamilyId', null) == myFamilyId() ||
           resource.data.get('toFamilyId', null) == myFamilyId())));

      allow create: if isSignedIn() &&
        request.auth.uid == request.resource.data.fromUid &&
        request.resource.data.toUid != request.auth.uid &&
        request.resource.data.fromApproved == !requiresApproval(request.resource.data.fromUid) &&
        request.resource.data.toApproved == !requiresApproval(request.resource.data.toUid) &&
        request.resource.data.status ==
          ((request.resource.data.fromApproved && request.resource.data.toApproved) ? 'accepted' : 'pending');

      allow update: if isSignedIn() &&
        (
          (isParentOf(resource.data.get('fromUid', null)) &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fromApproved', 'status']) &&
           (
             (request.resource.data.fromApproved == true &&
              request.resource.data.status == (resource.data.get('toApproved', false) == true ? 'accepted' : 'pending')) ||
             (request.resource.data.fromApproved == false && request.resource.data.status == 'rejected')
           )) ||
          (isParentOf(resource.data.get('toUid', null)) &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['toApproved', 'status']) &&
           (
             (request.resource.data.toApproved == true &&
              request.resource.data.status == (resource.data.get('fromApproved', false) == true ? 'accepted' : 'pending')) ||
             (request.resource.data.toApproved == false && request.resource.data.status == 'rejected')
           ))
        );

      allow delete: if false;
    }

    match /friendships/{friendshipId} {
      allow read: if isSignedIn() &&
        (request.auth.uid == resource.data.get('uid1', null) || request.auth.uid == resource.data.get('uid2', null));
      allow create: if isSignedIn() &&
        (request.auth.uid == request.resource.data.uid1 || request.auth.uid == request.resource.data.uid2 ||
         isParentOf(request.resource.data.uid1) || isParentOf(request.resource.data.uid2));
      allow update, delete: if false;
    }
  }
}
