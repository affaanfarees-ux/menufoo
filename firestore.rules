rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function myFamilyId() {
      return myProfile().familyId;
    }

    function isParent() {
      return isSignedIn() && myProfile().role == 'parent';
    }

    match /users/{userId} {
      allow read: if isSignedIn() &&
        (request.auth.uid == userId || resource.data.familyId == myFamilyId());
      allow create, update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /families/{familyId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.code == familyId;
      allow update, delete: if false;
    }

    match /lunches/{lunchId} {
      allow read: if isSignedIn() && resource.data.familyId == myFamilyId();
      allow create: if isSignedIn() &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.familyId == myFamilyId();
      allow update, delete: if isSignedIn() && resource.data.familyId == myFamilyId();
    }

    match /weeklyPlans/{planId} {
      allow read: if isSignedIn() && resource.data.familyId == myFamilyId();
      allow create, update: if isParent() && request.resource.data.familyId == myFamilyId();
      allow delete: if false;
    }
  }
}
